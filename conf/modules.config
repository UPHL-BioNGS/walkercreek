/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: "${params.publish_dir_mode}",
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: '.*SAMPLESHEET_CHECK.*' {
        publishDir = [
            path: { "${params.outdir}/pipeline_info" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'CUSTOM_DUMPSOFTWAREVERSIONS' {
        publishDir = [
            path: { "${params.outdir}/pipeline_info" },
            mode: params.publish_dir_mode,
            pattern: '*_versions.yml'
        ]
    }
}

includeConfig ({
    if (params.platform == 'flu_illumina') {
        return 'flu_illumina.config'
    } else if (params.platform == 'flu_nanopore') {
        return 'flu_nanopore.config'
    } else if (params.platform == 'flu_ww_nanopore') {
        return 'flu_ww_nanopore.config'
    } else if (params.platform == 'flu_ww_illumina') {
        return 'flu_ww_illumina.config'
    } else if (params.platform == 'rsv_illumina') {
        return 'rsv_illumina.config'
    } else {
        return '/dev/null'
    }
}())
