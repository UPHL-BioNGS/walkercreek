/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run main.nf -profile test,<docker/singularity> --platform flu_illumina --outdir <OUTDIR>

    Kraken2 will be skipped due to the resources required
----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function'
    skip_kraken2               = true
    platform                   = "flu_illumina"

    // Limit resources so that this can run on GitHub Actions
    max_cpus   = 2
    max_memory = '6.GB'
    max_time   = '6.h'

    // Input data
    add_sra_file = "${projectDir}/bin/sra_test.csv"
}

process {
    withName: 'SRATOOLS_PREFETCH' {
        cpus = 2
        memory = '6.GB'
        time = '6.h'
    }

    withName: 'SRATOOLS_FASTERQDUMP' {
        cpus = 2
        memory = '6.GB'
        time = '6.h'
    }

    withLabel: 'process_high' {
        cpus = 2
        memory = '6.GB'
        time = '6.h'
    }

    withLabel: 'process_medium' {
        cpus = 2
        memory = '6.GB'
        time = '6.h'
    }

    withLabel: 'process_low' {
        cpus = 1
        memory = '6.GB'
        time = '6.h'
    }
}
